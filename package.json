{
  "name": "prism-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node server.mjs --production",
    "test": "playwright test",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "test:unit": "node --test tests/local-ai.test.mjs",
    "test:desktop": "npm run build && node tests/desktop.smoke.mjs",
    "dist:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide": "^0.468.0",
    "vite": "^6.1.0"
  },
  "description": "Offline Windows image editor with layers and local generative AI integration",
  "author": "Prism Studio",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "studio.prism.editor",
    "productName": "Prism Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Prism-Studio-${version}-Setup-${arch}.${ext}"
    },
    "npmRebuild": false,
    "toolsets": {
      "wine": "1.0.1"
    },
    "portable": {
      "artifactName": "Prism-Studio-${version}-Portable-${arch}.${ext}",
      "useZip": true
    },
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  }
}
